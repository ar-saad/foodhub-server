model OrderItem {
  id      String @id @default(uuid())
  orderId String
  mealId  String

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id])
  meal  Meal  @relation(fields: [mealId], references: [id])

  createdAt DateTime @default(now())

  @@map("order_item")
}
